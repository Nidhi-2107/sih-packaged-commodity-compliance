# PARAKH — AI-Assisted Packaged Commodity Compliance & Inspection System
# Deployment & Environment Configuration Template

# Server Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Database & Storage Paths
DATABASE_PATH=./praman.db
UPLOAD_DIR=./uploads

# URLs & CORS
CLIENT_URL=http://localhost:5173
API_BASE_URL=/api

# Primary Vision AI Provider (gemini | openai)
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.0-flash

# API Keys (Keep secret! NEVER commit real keys to version control)
GEMINI_API_KEY=
OPENAI_API_KEY=
